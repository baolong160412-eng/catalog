local function httpGet(url)
if syn and syn.request then
local ok, r = pcall(syn.request, {Url = url, Method = "GET"})
if ok and r and r.Body then return r.Body end
end
if http_request then
local ok, r = pcall(http_request, {Url = url, Method = "GET"})
if ok and r and r.Body then return r.Body end
end
if request then
local ok, r = pcall(request, {Url = url, Method = "GET"})
if ok and r and r.Body then return r.Body end
end
return game:HttpGet(url)
end
local function layId(input)
if not input or input == "" then return nil end
input = input:gsub("%s", "")
local id = input:match("https?://[^/]+/catalog/(%d+)")
or input:match("https?://[^/]+/bundles/(%d+)")
or input:match("https?://[^/]+/library/(%d+)")
or input:match("^%d+$")
return id and tonumber(id) or nil
end
local function layThongTin(id)
local ok, body = pcall(httpGet, "https://economy.roblox.com/v2/assets/" .. tostring(id) .. "/details")
if not ok or not body then return nil end
local ok2, data = pcall(HttpService.JSONDecode, HttpService, body)
if not ok2 or not data then return nil end
return data
end
local function layAnh(id)
local ok, body = pcall(httpGet, "https://thumbnails.roblox.com/v1/assets?assetIds=" .. tostring(id) .. "&size=150x150&format=Png")
if not ok or not body then return nil end
local ok2, data = pcall(HttpService.JSONDecode, HttpService, body)
if not ok2 or not data or not data.data or not data.data[1] then return nil end
return data.data[1].imageUrl
end
